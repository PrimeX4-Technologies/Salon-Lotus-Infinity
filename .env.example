# Backend API base, including its version prefix. Never place secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Must match GOOGLE_CLIENT_ID on the backend. Leave blank to hide Google Sign-In.
VITE_GOOGLE_CLIENT_ID=

# Must match AUTH_CSRF_COOKIE_NAME on the backend.
VITE_AUTH_CSRF_COOKIE_NAME=salon_csrf

# Use / for a normal domain deployment. The GitHub Pages workflow overrides this.
VITE_BASE_PATH=/
